---
interface Props { src: string; cls?: string }
const { src, cls = "" } = Astro.props;
const contain = src.endsWith(".svg") || src.includes("dr-circuit");
const panel = src.includes("/img/covers/");
---
<div class={`cover ${contain ? "contain" : ""} ${panel ? "panel" : ""} ${cls}`}><img src={src} alt="" loading="lazy" decoding="async"></div>
