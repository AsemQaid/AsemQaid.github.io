---
import Base from "../layouts/Base.astro";
import { PROFILE, getProjects, tr, url, type Lang } from "../i18n/ui";
import CV from "../data/cv.json";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const projects = await getProjects(lang);
const P = (id: string) => projects.find((p) => p.slug === id)!;

// Every word of the CV comes from src/data/cv.json, the same file the PDF is built from,
// so the page and the PDF always match. Project order follows the `order` field.
const L = (o: { en: string; ar: string }) => o[lang];
const rank = new Map(projects.map((p, i) => [p.slug, i]));
const PROJ = [...CV.projects].sort((a, b) => rank.get(a.id)! - rank.get(b.id)!);
---
<Base lang={lang} path="/cv/" section="cv" title={T("CV", "السيرة الذاتية")}>
  <div class="wrap"><header class="page-head"><div class="eyebrow mono"><span class="dot"></span>{T("Curriculum vitae", "السيرة الذاتية")}</div><h1 class="h-page">CV</h1>
    <p class="lede">{L(CV.headline)}</p></header>
  <div class="cv"><div style="min-width:0">
    <section class="cv-sec"><h2>{T("Profile", "نبذة")}</h2><div class="cv-entry"><span class="w" style="font-size:1rem;line-height:1.65">{L(CV.profile)}</span></div></section>
    <section class="cv-sec"><h2>{T("Education", "التعليم")}</h2><div>
      <div class="cv-entry"><div class="top"><span class="t">{L(CV.education.degree)}</span><span class="d mono">{L(CV.education.date)}</span></div><span class="w">{L(CV.education.school)}</span>
        <ul>{CV.education.bullets.map((b) => <li>{L(b)}</li>)}</ul></div></div></section>
    <section class="cv-sec"><h2>{T("Engineering projects", "المشاريع الهندسية")}</h2><div>
      {PROJ.map((x) => (
        <div class="cv-entry"><div class="top"><span class="t"><a href={url(lang, `/work/${x.id}/`)}>{lang === "en" ? x.title : P(x.id).data.title}</a></span><span class="d mono">{L(x.date)}</span></div><span class="w">{L(x.ctx)}</span>
          <ul>{x.bullets.map((b) => <li>{L(b)}</li>)}</ul>{x.tools && <span class="w cv-tools">{T("Tools", "الأدوات")}: <span class="ltr">{x.tools}</span></span>}</div>
      ))}
    </div></section>
    <section class="cv-sec"><h2>{T("Leadership", "القيادة")}</h2><div>
      {CV.leadership.map((x) => (
        <div class="cv-entry"><div class="top"><span class="t">{L(x.title)}</span><span class="d mono">{L(x.date)}</span></div>{x.ctx && <span class="w">{L(x.ctx)}</span>}
          <ul>{x.bullets.map((b) => <li>{L(b)}</li>)}</ul></div>
      ))}
    </div></section>
    <section class="cv-sec"><h2>{T("Technical skills", "المهارات التقنية")}</h2><div class="cv-entry"><ul>
      {CV.skills.map((x) => <li><strong>{L(x.k)}:</strong> {L(x.v)}</li>)}
    </ul></div></section>
    <section class="cv-sec"><h2>{T("Honours, memberships and languages", "التكريمات والعضويات واللغات")}</h2><div class="cv-entry"><ul>
      {CV.honours.map((h) => <li>{L(h)}</li>)}</ul></div></section>
  </div>
  <aside class="cv-side">
    <div class="box"><h4>{T("PDF version", "نسخة PDF")}</h4><p style="margin:0;color:var(--ink-2);font-size:.92rem">{T("The same CV as a PDF for applications.", "السيرة الذاتية نفسها بصيغة PDF للتقديم.")}</p>
      <a class="btn btn-primary" href={PROFILE.cv} target="_blank" rel="noopener" style="justify-self:start">{T("Download CV (PDF)", "تنزيل السيرة الذاتية (PDF)")}</a></div>
    <div class="box"><h4>{T("Quick facts", "معلومات سريعة")}</h4><div class="res-meta">
      <span class="k mono">{T("Based in", "المقر")}</span><span>{T("Yogyakarta, Indonesia", "يوجياكارتا، إندونيسيا")}</span>
      <span class="k mono">{T("Nationality", "الجنسية")}</span><span>{T("Yemeni", "يمني")}</span>
      <span class="k mono">{T("Open to", "متاح لـ")}</span><span>{T("Internships, research", "التدريب، البحث")}</span>
      <span class="k mono">{T("Focus", "التركيز")}</span><span>{T("Embedded hardware · control · energy", "العتاد المدمج · التحكم · الطاقة")}</span></div>
      <a class="btn btn-ghost" href={url(lang, "/contact/")} style="justify-self:start">{T("Contact", "تواصل")}</a></div>
  </aside></div></div>
</Base>
