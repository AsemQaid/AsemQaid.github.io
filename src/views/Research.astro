---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { getProjects, tr, url, type Lang } from "../i18n/ui";
import { PUBLICATIONS } from "../data/publications";

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const projects = await getProjects(lang);
const P = (slug: string) => projects.find((p) => p.slug === slug)!;
const areas = [
  [T("Semiconductor devices & microelectronics", "أجهزة أشباه الموصلات والإلكترونيات الدقيقة"), T("A developing interest, building on microprocessor interfacing and digital logic coursework. No semiconductor project yet; this is where I want to grow.", "اهتمام ناشئ ينطلق من ربط المعالجات الدقيقة ومقررات المنطق الرقمي. لا يوجد مشروع في أشباه الموصلات بعد؛ وهذا هو المجال الذي أريد أن أنمو فيه."), T("Developing interest", "اهتمام ناشئ"), []],
  [T("Digital electronics & hardware systems", "الإلكترونيات الرقمية وأنظمة العتاد"), T("8086 assembly with an 8255 PPI and ADC0804, verified in Proteus; digital logic design in Quartus Prime (coursework).", "لغة تجميع 8086 مع 8255 وADC0804 متحقق منها في Proteus؛ وتصميم منطق رقمي في Quartus Prime (مقرر)."), T("Project and coursework", "مشروع ومقرر"), ["dryer-8086"]],
  [T("Embedded systems & electronics", "الأنظمة المدمجة والإلكترونيات"), T("State machines, isolated power design, PCB assembly, GSM and MQTT alerting.", "آلات الحالات، وتصميم طاقة معزولة، وتجميع PCB، والتنبيه عبر GSM وMQTT."), T("Two projects", "مشروعان"), ["panel-protection", "flood-warning"]],
  [T("Instrumentation & measurement", "القياس والأجهزة"), T("Calibration, filtering and benchmarking low-cost sensors against reference measurements.", "المعايرة والترشيح ومقارنة الحساسات منخفضة التكلفة بقياسات مرجعية."), T("Two projects", "مشروعان"), ["mpu6050-speed", "mq135-gas"]],
  [T("Power electronics", "إلكترونيات القدرة"), T("Rectifiers, regulators and the grid-tied inverter modelled and tested in EE Studio.", "المقوّمات والمنظمات والعاكس الشبكي منمذجة ومختبرة في EE Studio."), T("Software models", "نماذج برمجية"), ["ee-studio"]],
  [T("Power systems & renewable energy", "أنظمة القدرة والطاقة المتجددة"), T("Industrial energy monitoring with anomaly detection; power flow, faults and renewables in EE Studio.", "مراقبة الطاقة الصناعية مع كشف الشذوذ؛ وسريان القدرة والأعطال والطاقة المتجددة في EE Studio."), T("Active project", "مشروع جارٍ"), ["energy-copilot", "ee-studio"]],
] as const;
---
<Base lang={lang} path="/research/" section="research" title={T("Research", "البحث")}>
  <div class="wrap">
    <header class="page-head"><div class="eyebrow mono"><span class="dot"></span>{T("Research", "البحث")}</div>
      <h1 class="h-page">{T("Research directions", "الاتجاهات البحثية")}</h1>
      <p class="lede">{PUBLICATIONS.length ? T("What I am studying, the evidence behind each interest, and my publications.", "ما أدرسه والأدلة وراء كل اهتمام، ومنشوراتي.") : T("I have not published yet. This page shows what I am studying, the evidence behind each interest, and where I want to go.", "لم أنشر أبحاثًا بعد. توضح هذه الصفحة ما أدرسه والأدلة وراء كل اهتمام وإلى أين أريد أن أتجه.")}</p></header>
    <section class="sec"><div class="sec-head"><h2 class="h-sec">{T("Interests and evidence", "الاهتمامات والأدلة")}</h2></div>
      <div class="rmap">
        {areas.map(([t, d, l, ids], i) => (
          <div><span class="lv mono">{i === 0 ? <b>{l}</b> : l}</span><h3>{t}</h3><p>{d}</p>
            {ids.length > 0 && <div class="plinks">{ids.map((id) => <a href={url(lang, `/work/${id}/`)} class="plink"><span class="ltr">{P(id).data.number}</span> {P(id).data.title}</a>)}</div>}</div>
        ))}
        
      </div></section>
    <section class="sec"><div class="sec-head"><h2 class="h-sec">{T("Closest to research so far", "الأقرب إلى البحث حتى الآن")}</h2></div>
      <a class="feature-research" href={url(lang, "/work/mpu6050-speed/")}>
        <img src="/diagrams/mpu-rmse.svg" alt="" loading="lazy">
        <div><span class="mono" style="color:var(--ink-3)"><span class="ltr">AAQ-P03</span> · {T("Measurement & Instrumentation", "القياس والأجهزة")}</span>
          <h3>{T("Why step counting beat integration by a factor of seven", "لماذا تفوّق عدّ الخطوات على التكامل بسبعة أضعاف")}</h3>
          <p>{T("A benchmark of two speed-estimation methods against 15 reference trials each, with a physical explanation of the error: integration drift grows with time, while event counting does not.", "مقارنة طريقتين لتقدير السرعة مقابل 15 تجربة مرجعية لكل منهما، مع تفسير فيزيائي للخطأ: انجراف التكامل يكبر مع الزمن، بينما لا يكبر عدّ الأحداث.")}</p>
          <span class="link-arrow">{T("Read the project", "اقرأ المشروع")} <Arrow /></span></div></a></section>
    <section class="sec"><div class="sec-head"><h2 class="h-sec">{T("Publications", "المنشورات")}</h2><span class="mono" style="color:var(--ink-3)">{PUBLICATIONS.length} {T("entries", "إدخالات")}</span></div>
      {PUBLICATIONS.length === 0 ? (
        <div class="pub-empty"><p style="margin:0;font-size:1.02rem">{T("No publications yet. Papers, posters and conference reports will be listed here.", "لا توجد منشورات بعد. ستُدرج هنا الأوراق والملصقات وتقارير المؤتمرات.")}</p></div>
      ) : (
        <div style="display:grid;gap:12px">{PUBLICATIONS.map((p) => (
          <div class="pub" style="border-style:solid;background:var(--sheet)"><span class="yr ltr">{p.year}</span><div style="display:grid;gap:4px;min-width:0" dir="ltr">
            <span class="ti">{p.title}</span><span class="au" set:html={p.authors.replace("A. A. Qaid", "<strong>A. A. Qaid</strong>")}></span><span class="ve">{p.venue}</span>
            <div class="acts">{p.links.map((l) => <a class="tag" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}</div></div></div>
        ))}</div>
      )}</section>
    <section class="sec"><div class="sec-head"><h2 class="h-sec">{T("Working toward", "أعمل نحو")}</h2></div>
      <div class="split">
        <div class="box"><h4>{T("Next", "التالي")}</h4><ul><li>{T("Bench validation of the energy acquisition unit (ANGEL 2026, December)", "التحقق المخبري من وحدة اقتناء الطاقة (ANGEL 2026، ديسمبر)")}</li><li>{T("An internship, research or technical development role in electronics, semiconductors or energy systems", "تدريب أو دور بحثي أو تطوير تقني في الإلكترونيات أو أشباه الموصلات أو أنظمة الطاقة")}</li><li>{T("A first paper, poster or conference report", "أول ورقة أو ملصق أو تقرير مؤتمر")}</li></ul></div>
        <div class="box"><h4>{T("Long-term", "على المدى البعيد")}</h4><ul><li>{T("Develop skills in semiconductor devices, microelectronics and digital hardware", "تطوير مهارات في أجهزة أشباه الموصلات والإلكترونيات الدقيقة والعتاد الرقمي")}</li><li>{T("Apply electronics to power electronics, power systems and renewable energy", "تطبيق الإلكترونيات في إلكترونيات القدرة وأنظمة القدرة والطاقة المتجددة")}</li></ul></div>
      </div></section>
  </div>
</Base>
