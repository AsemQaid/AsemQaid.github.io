---
import Base from "../layouts/Base.astro";
import { getProjects, tr, url, type Lang } from "../i18n/ui";
import { USED, LEARNING } from "../data/skills";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = tr(lang);
const projects = await getProjects(lang);
const slugOf = (code: string) => projects.find((p) => p.data.number === `AAQ-${code}`)?.slug;
const L = (x: string | { en: string; ar: string }) => (typeof x === "string" ? x : x[lang]);
---
<Base lang={lang} path="/about/" section="about" title={T("About", "نبذة")}>
  <div class="wrap"><header class="page-head"><div class="eyebrow mono"><span class="dot"></span>{T("About", "نبذة")}</div><h1 class="h-page">{T("Engineer first, organiser by practice", "مهندس أولًا، ومنظِّم بالممارسة")}</h1></header>
  <div class="about-grid">
    <div class="about-fig"><figure><img src="/img/portrait.jpg" alt={T("Portrait of Asem Ameen Qaid", "صورة عاصم أمين قائد")}></figure>
      <div class="cap mono"><span>{T("Plate 02", "لوحة 02")}</span><span>{T("Yogyakarta, 2026", "يوجياكارتا، 2026")}</span></div></div>
    <div style="display:grid;gap:40px;min-width:0">
      <div class="prose">
        <p>{T("I am a third-year electrical engineering student at Universitas Islam Indonesia in Yogyakarta, studying on the Future Global Leaders Scholarship. I am originally from Yemen, and I work in Arabic, English and Indonesian.", "أنا طالب في السنة الثالثة في الهندسة الكهربائية بالجامعة الإسلامية الإندونيسية في يوجياكارتا، وأدرس بمنحة Future Global Leaders. أصلي من اليمن، وأعمل بالعربية والإنجليزية والإندونيسية.")}</p>
        <p>{T("Across my projects, from microprocessor control and sensor measurement to embedded protection and energy monitoring, I try to do the same thing: measure before claiming, and say clearly what has and has not been tested.", "في كل مشاريعي، من التحكم بالمعالجات الدقيقة وقياس الحساسات إلى الحماية المدمجة ومراقبة الطاقة، أحاول فعل الشيء نفسه: أن أقيس قبل أن أدّعي، وأن أوضح ما الذي اختُبر وما الذي لم يُختبر.")}</p>
        <p>{T("I build electronic hardware and test it properly. Most of my projects are applied to control and energy systems, from a microprocessor-based controller to an industrial energy monitoring platform. I am looking for an internship or research role where I can design, build and test electronic hardware.", "أبني عتادًا إلكترونيًا وأختبره كما ينبغي. ومعظم مشاريعي موجّهة إلى أنظمة التحكم والطاقة، من متحكم يعمل بمعالج دقيق إلى منصة لمراقبة الطاقة الصناعية. أبحث عن تدريب أو دور بحثي أصمّم فيه عتادًا إلكترونيًا وأبنيه وأختبره.")}</p>
        <p>{T("Alongside engineering, I lead UII Global, the university's international student organisation.", "إلى جانب الهندسة، أقود UII Global، منظمة الطلاب الدوليين في الجامعة.")} <a href={url(lang, "/leadership/")}>{T("Leadership", "القيادة")}</a></p>
      </div>
      <div class="skillset" data-skillset>
        <div class="skill-head"><h2 class="h-sec">{T("Skills, with evidence", "المهارات مع الدليل")}</h2>
          <div class="slide-sw" role="group" aria-label={T("Show skills", "عرض المهارات")}>
            <button type="button" data-sv="used" aria-pressed="true">{T("Used in projects", "مُستخدمة في مشاريع")}</button>
            <button type="button" data-sv="learning" aria-pressed="false">{T("Learning now", "أتعلّمها الآن")}</button>
            <span class="knob" aria-hidden="true"></span>
          </div></div>
        <div data-sp="used">
          <div class="skills">{USED.map((r) => <div class="skill-row"><span class="k">{r.k[lang]}</span><div class="items">{r.items.map((it) => (
            <span class="skill"><span>{L(it.n)}</span><span class="src ltr">{it.p ? it.p.map((c) => { const sl = slugOf(c); return sl ? <a href={url(lang, `/work/${sl}/`)}>{c}</a> : <span>{c}</span>; }) : <span>{it.note?.[lang]}</span>}</span></span>
          ))}</div></div>)}</div>
          <p class="mono" style="color:var(--ink-3);margin-top:12px">{T("Each code links to the project where the skill was used.", "كل رمز يفتح المشروع الذي استُخدمت فيه المهارة.")}</p>
        </div>
        <div data-sp="learning" hidden>
          <ul class="learning">{LEARNING.map((x) => <li><span class="skill learn"><span>{x.n[lang]}</span></span><span class="where">{x.where[lang]}</span></li>)}</ul>
          <p class="mono" style="color:var(--ink-3);margin-top:12px">{T("Not yet shown in a project. Each one moves to the other list once a project proves it.", "لم تظهر بعد في مشروع. تنتقل كل واحدة إلى القائمة الأخرى عندما يثبتها مشروع.")}</p>
        </div>
      </div>
      <div><h2 class="h-sec" style="margin-bottom:16px">{T("Languages", "اللغات")}</h2>
        <div class="skills">{[[T("Arabic", "العربية"), T("Native", "اللغة الأم")], [T("English", "الإنجليزية"), T("Professional working proficiency", "كفاءة مهنية")], [T("Indonesian", "الإندونيسية"), T("Intermediate", "متوسط")]].map(([a, b]) => <div class="skill-row"><span class="k">{a}</span><span>{b}</span></div>)}</div></div>
    </div>
  </div></div>
</Base>
