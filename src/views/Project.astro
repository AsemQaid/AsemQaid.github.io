---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Status from "../components/Status.astro";
import { DOMAINS, getProjects, tr, url, type Lang, type Project } from "../i18n/ui";

interface Props { lang: Lang; project: Project }
const { lang, project: p } = Astro.props;
const T = tr(lang);
const { Content, headings } = await render(p);
const h2 = headings.filter((h) => h.depth === 2);
const all = await getProjects(lang);
const next = all[(all.findIndex((x) => x.slug === p.slug) + 1) % all.length];
const d = p.data;
const ext = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 1.5h6v6M10.5 1.5 4 8M8.5 7v3.5h-7v-7H5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>';
const btnLabel = (r: { type: string; url: string }) =>
  r.type === "PDF" ? T("Open PDF", "فتح الملف") : r.type === "ASM" || r.type === "CODE" ? T("View code", "عرض الشيفرة") : T("Open", "فتح");
---
<Base lang={lang} path={`/work/${p.slug}/`} section="work" title={d.title} description={d.summary}>
  <div class="wrap">
    <div style="padding-top:28px" class="crumbs mono"><a href={url(lang, "/work/")}>{T("Work", "الأعمال")}</a><span>/</span><span class="ltr">{d.number}</span>{d.inProgress && <span class="prog-tag">{T("In progress", "قيد التنفيذ")}</span>}</div>
    {p.fallback && <p class="note-fallback mono" style="margin:12px 0 0;color:var(--ink-3)">هذه الصفحة متاحة بالإنجليزية فقط حاليًا.</p>}
    <header class="p-head">
      <div style="display:grid;gap:16px;min-width:0">
        <h1 class="h-page" style="font-size:clamp(1.9rem,4.2vw,3.2rem)">{d.title}</h1>
        <p class="lede">{d.lede}</p>
      </div>
      <div class="p-tb">
        <div class="tb-title mono"><span class="ltr">{d.number}</span><span>{DOMAINS[d.domain][lang]}</span></div>
        {d.facts.map((f) => <div class="row"><span class="k mono">{f.label}</span><span class="v">{f.value}</span></div>)}
      </div>
    </header>
    <div class="verif" aria-label={T("Verification status", "حالة التحقق")}>
      {d.verification.map((v) => <div><span class="mono" style="color:var(--ink-3)">{v.label}</span><Status s={v.status} lang={lang} /><p>{v.text}</p></div>)}
    </div>
    <div class="p-body">
      <nav class="toc" aria-label={T("On this page", "في هذه الصفحة")}>
        <span class="k mono">{T("On this page", "في هذه الصفحة")}</span>
        {h2.map((h) => <a href={`#${h.slug}`} data-anchor={h.slug}>{h.text}</a>)}
        <a href="#resources" data-anchor="resources">{T("Resources", "المصادر")}</a>
      </nav>
      <div class="p-content" style="min-width:0">
        <div class="prose"><Content /></div>
        {(d.shown || d.limits) && (
          <div class="split" style="margin-top:22px">
            {d.shown && <div class="box"><h4><span class="sw" style="background:var(--st-valid)"></span>{T("Shown", "ما ثبت")}</h4><ul>{d.shown.map((x) => <li>{x}</li>)}</ul></div>}
            {d.limits && <div class="box"><h4><span class="sw" style="border:1px dashed var(--ink-3)"></span>{T("Limits and next steps", "الحدود والخطوات التالية")}</h4><ul>{d.limits.map((x) => <li>{x}</li>)}</ul></div>}
          </div>
        )}
        <section class="p-sec" id="resources" style="margin-top:36px">
          <h2 class="h-sec" style="margin-bottom:18px">{T("Resources", "المصادر")}</h2>
          <ul class="reslist">
            {d.resources.map((r) => (
              <li class="res-row"><span class="res-ico">{r.type === "CODE" ? "</>" : r.type}</span>
                <span style="min-width:0"><span class="t">{r.label}</span><span class="s mono ltr">{r.host}</span></span>
                <a class="btn btn-primary btn-sm" href={r.url} target="_blank" rel="noopener">{btnLabel(r)} <Fragment set:html={ext} /></a></li>
            ))}
          </ul>
        </section>
        <nav class="pnext" aria-label={T("More projects", "مزيد من المشاريع")}>
          <a href={url(lang, "/work/")}><span class="mono" style="color:var(--ink-3)">{T("Back", "رجوع")}</span><span class="t">{T("Project register", "سجل المشاريع")}</span></a>
          <a href={url(lang, `/work/${next.slug}/`)}><span class="mono" style="color:var(--ink-3)">{T("Next", "التالي")} · <span class="ltr">{next.data.number}</span></span><span class="t">{next.data.title}</span></a>
        </nav>
      </div>
    </div>
  </div>
</Base>
