---
import View from "../../../views/Project.astro";
import { getProjects } from "../../../i18n/ui";
export async function getStaticPaths() {
  return (await getProjects("ar")).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<View lang="ar" project={project} />
